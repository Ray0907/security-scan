                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dirty": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "commit",
            "branch",
            "dirty"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "scanners": {
      "type": "array",
